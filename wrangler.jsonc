{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-whois-ui",
  "account_id": "0d182ecb26fef6f7f944296115e0cbf8",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    { "pattern": "94.cx/*", "zone_name": "94.cx" },
    { "pattern": "www.94.cx/*", "zone_name": "94.cx" }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "next-whois-ui"
    }
  ],
  "vars": {
    "RDAP_DNS_FAMILY": "auto"
  },
  "observability": {
    "enabled": true
  }
}
