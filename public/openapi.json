{
  "openapi": "3.1.0",
  "info": {
    "title": "94.cx Registration Lookup API",
    "version": "2.0.0",
    "description": "Public application endpoint with no built-in API key, quota or concurrency enforcement. Deployment gateways and upstream registries may impose limits. See /api-docs for cache freshness, source limitations and legacy compatibility."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [],
  "paths": {
    "/api/v2/lookup": {
      "get": {
        "operationId": "lookupRegistration",
        "summary": "Look up domain, IP, ASN or CIDR registration data",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Exactly one domain, IPv4, IPv6, ASN (1–4294967295, optional AS), or CIDR. URLs are rejected. IDNs use Punycode; subdomains resolve to their registrable domain; CIDR host bits are cleared.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "examples": {
              "domain": {
                "value": "example.com"
              },
              "ip": {
                "value": "1.1.1.1"
              },
              "asn": {
                "value": "AS13335"
              },
              "ipv6": {
                "value": "2001:4860:4860::8888"
              },
              "cidr": {
                "value": "1.1.1.0/24"
              },
              "idn": {
                "value": "中国.cn"
              }
            }
          },
          {
            "name": "includeRaw",
            "in": "query",
            "description": "Opt into 64 KiB of raw data. Complete RDAP is an object; truncated RDAP is text in rdapPreview.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok, partial or not_found; inspect outcome.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LookupResponse"
                },
                "examples": {
                  "domain": {
                    "summary": "Illustrative response, not a live quote",
                    "value": {
                      "outcome": "ok",
                      "source": {
                        "protocol": "rdap",
                        "server": null
                      },
                      "error": null,
